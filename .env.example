# Copy to .env (never committed). Docker Compose reads it.
NEO4J_PASSWORD=change-me-to-a-long-password
# Which parser ingests filings (see backend/src/bloomberg_invest/bootstrap.py).
PARSER=docling
# Token caps: a section's text Chunk, and a table read one line per row (longer tables split
# between rows).
CHUNK_CAP=2000
TABLE_CAP=1500
# Which model embeds Chunks and queries (see bootstrap.py). Changing it means re-embedding.
EMBEDDER=qwen3-0.6b
# Which LLM extracts figures, and how many pages go to it at once.
LLM=azure-openai
EXTRACT_CONCURRENCY=4
# Azure OpenAI, which extracts financial figures at ingest (Azure portal > the resource > Keys and
# Endpoint). Never commit real values.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
EXTRACT_DEPLOYMENT=gpt-5.6-sol
