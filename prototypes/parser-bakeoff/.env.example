# Copy outside the repo (e.g. ~/.config/bloomberg-invest/bakeoff.env) and pass it with
# `uv run --env-file <path> bakeoff ...`. Never commit real values.

# Azure Document Intelligence, for `bakeoff parse azure`. Azure portal > your Document Intelligence
# resource > Keys and Endpoint.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<resource-name>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Azure OpenAI, for `bakeoff extract`. Azure portal > your Azure OpenAI (or AI Foundry) resource
# > Keys and Endpoint; deployments are listed under Deployments.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
# Comma-separated deployment names to compare, e.g. a large and a small model.
AZURE_OPENAI_DEPLOYMENTS=

# Optional: any other OpenAI-compatible server (vLLM, Ollama...) instead of Azure OpenAI.
# `--deployments` then takes its model names.
# LLM_BASE_URL=http://localhost:8000/v1
# LLM_API_KEY=
