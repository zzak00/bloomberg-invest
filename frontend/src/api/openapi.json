{
  "openapi": "3.1.0",
  "info": {
    "title": "Bloomberg Invest",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Api Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents": {
      "get": {
        "summary": "List Documents",
        "operationId": "list_documents_api_documents_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DocumentSummary"
                  },
                  "type": "array",
                  "title": "Response List Documents Api Documents Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{document_id}": {
      "get": {
        "summary": "Document Detail",
        "operationId": "document_detail_api_documents__document_id__get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetail"
                }
              }
            }
          },
          "404": {
            "description": "No such document, or no such page in it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/documents/{document_id}/pages/{number}.png": {
      "get": {
        "summary": "Page Image",
        "operationId": "page_image_api_documents__document_id__pages__number__png_get",
        "parameters": [
          {
            "name": "document_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Document Id"
            }
          },
          {
            "name": "number",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "title": "Number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/png": {}
            }
          },
          "404": {
            "description": "No such document, or no such page in it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "get": {
        "summary": "Search Chunks",
        "description": "The current Chunks nearest the query, best first.",
        "operationId": "search_chunks_api_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "\\S",
              "title": "Q"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 10,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Chunk"
                  },
                  "title": "Response Search Chunks Api Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chunks/{chunk_id}": {
      "get": {
        "summary": "Chunk",
        "description": "One Chunk, current or not, so a search result's link keeps working after a re-chunk.",
        "operationId": "chunk_api_chunks__chunk_id__get",
        "parameters": [
          {
            "name": "chunk_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chunk Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Chunk"
                }
              }
            }
          },
          "404": {
            "description": "No such chunk",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Box": {
        "properties": {
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "left": {
            "type": "number",
            "title": "Left"
          },
          "top": {
            "type": "number",
            "title": "Top"
          },
          "right": {
            "type": "number",
            "title": "Right"
          },
          "bottom": {
            "type": "number",
            "title": "Bottom"
          }
        },
        "type": "object",
        "required": [
          "page",
          "left",
          "top",
          "right",
          "bottom"
        ],
        "title": "Box",
        "description": "A region of a page in PDF points, top-left origin."
      },
      "Chunk": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "table"
            ],
            "title": "Kind"
          },
          "text": {
            "type": "string",
            "title": "Text"
          },
          "pages": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Pages"
          },
          "boxes": {
            "items": {
              "$ref": "#/components/schemas/Box"
            },
            "type": "array",
            "title": "Boxes"
          },
          "section_path": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Section Path"
          },
          "document": {
            "$ref": "#/components/schemas/DocumentRef"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "text",
          "pages",
          "boxes",
          "section_path",
          "document"
        ],
        "title": "Chunk",
        "description": "A Chunk with where to find it: what search returns and the source viewer highlights."
      },
      "DocType": {
        "type": "string",
        "enum": [
          "annual_report",
          "half_year_report",
          "issuer_page"
        ],
        "title": "DocType"
      },
      "DocumentDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "issuer": {
            "$ref": "#/components/schemas/Organisation"
          },
          "doc_type": {
            "$ref": "#/components/schemas/DocType"
          },
          "fiscal_year": {
            "type": "integer",
            "title": "Fiscal Year"
          },
          "regulator": {
            "type": "string",
            "title": "Regulator"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "ingested_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ingested At"
          },
          "sha256": {
            "type": "string",
            "title": "Sha256"
          },
          "pages": {
            "items": {
              "$ref": "#/components/schemas/PageInfo"
            },
            "type": "array",
            "title": "Pages"
          },
          "sections": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array",
            "title": "Sections"
          },
          "run": {
            "$ref": "#/components/schemas/Run"
          }
        },
        "type": "object",
        "required": [
          "id",
          "issuer",
          "doc_type",
          "fiscal_year",
          "regulator",
          "source_url",
          "page_count",
          "ingested_at",
          "sha256",
          "pages",
          "sections",
          "run"
        ],
        "title": "DocumentDetail"
      },
      "DocumentRef": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "issuer": {
            "$ref": "#/components/schemas/Organisation"
          },
          "doc_type": {
            "$ref": "#/components/schemas/DocType"
          },
          "fiscal_year": {
            "type": "integer",
            "title": "Fiscal Year"
          }
        },
        "type": "object",
        "required": [
          "id",
          "issuer",
          "doc_type",
          "fiscal_year"
        ],
        "title": "DocumentRef"
      },
      "DocumentSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "issuer": {
            "$ref": "#/components/schemas/Organisation"
          },
          "doc_type": {
            "$ref": "#/components/schemas/DocType"
          },
          "fiscal_year": {
            "type": "integer",
            "title": "Fiscal Year"
          },
          "regulator": {
            "type": "string",
            "title": "Regulator"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "page_count": {
            "type": "integer",
            "title": "Page Count"
          },
          "ingested_at": {
            "type": "string",
            "format": "date-time",
            "title": "Ingested At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "issuer",
          "doc_type",
          "fiscal_year",
          "regulator",
          "source_url",
          "page_count",
          "ingested_at"
        ],
        "title": "DocumentSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NotFound": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "NotFound"
      },
      "Organisation": {
        "properties": {
          "isin": {
            "type": "string",
            "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
            "title": "Isin"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "isin",
          "name"
        ],
        "title": "Organisation",
        "description": "The Organisation a filing comes from. Keyed by the ISIN the operator gives until\nListings (which own the ISIN in AGENTS.md) arrive in #24."
      },
      "PageInfo": {
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Number"
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Width"
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Height"
          }
        },
        "type": "object",
        "required": [
          "number",
          "width",
          "height"
        ],
        "title": "PageInfo"
      },
      "Run": {
        "properties": {
          "step": {
            "$ref": "#/components/schemas/RunStep"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "tool_version": {
            "type": "string",
            "title": "Tool Version"
          },
          "config": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Config"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time",
            "title": "Finished At"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus",
            "default": "succeeded"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "output": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output"
          },
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "step",
          "tool",
          "tool_version",
          "config",
          "started_at",
          "finished_at",
          "id"
        ],
        "title": "Run"
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "succeeded",
          "failed"
        ],
        "title": "RunStatus"
      },
      "RunStep": {
        "type": "string",
        "enum": [
          "parse",
          "chunk",
          "embed"
        ],
        "title": "RunStep",
        "description": "The processing steps a Run records (AGENTS.md); later steps add theirs."
      },
      "Section": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "level": {
            "type": "integer",
            "title": "Level"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "bbox": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 4,
                "minItems": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox"
          },
          "children": {
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "type": "array",
            "title": "Children",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "level",
          "page",
          "bbox"
        ],
        "title": "Section"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
